ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1
ui-theme:
  preference: system
agent-default-model:
  provider: lesec
  model: cn:deepseek-v4.1-flash
agent-presets:
  default: standard
llm-pi-ai:
  providers:
    claudex:
      displayName: claudex
      apiKeyEnv: CLAUDEX_API_KEY
      api: openai-completions
      baseURL: https://claudex.org/v1
      models:
        - id: deepseek-v4.1-flash
          name: deepseek-v4.1-flash
    a-lang:
      displayName: a-lang
      apiKeyEnv: A_LANG_API_KEY
      api: openai-completions
      baseURL: https://langlangya.dpdns.org/v1
      models:
        - id: deepseek-v4.1-flash
          name: deepseek-v4.1-flash
    lesec:
      displayName: lesec
      apiKeyEnv: LESEC_API_KEY
      api: openai-completions
      baseURL: https://ai.lesec.top/v1
      models:
        - id: cn:deepseek-v4.1-flash
          name: cn:deepseek-v4.1-flash
        - id: deepseek-v4.1-flash
          name: deepseek-v4.1-flash
ui-conversation:
  busyEnter: steer
